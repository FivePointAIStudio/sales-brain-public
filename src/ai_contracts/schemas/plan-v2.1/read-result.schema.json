{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "as_of": {
      "anyOf": [
        {
          "format": "date-time",
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "code": {
      "anyOf": [
        {
          "maxLength": 240,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "data": {
      "type": "object"
    },
    "retryable": {
      "type": "boolean"
    },
    "source_refs": {
      "items": {
        "maxLength": 240,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "type": "array",
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "ok",
        "not_found",
        "partial",
        "stale",
        "conflict",
        "unavailable",
        "forbidden",
        "invalid_request",
        "timeout",
        "error"
      ]
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "required": [
    "status",
    "data",
    "source_refs",
    "code",
    "retryable",
    "as_of",
    "truncated"
  ],
  "type": "object"
}
