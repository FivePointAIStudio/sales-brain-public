{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-sales:data-v1:catalog-change",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "scope_fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "product_id": {
      "type": "string",
      "minLength": 1
    },
    "variant_id": {
      "type": "string"
    },
    "operation": {
      "enum": [
        "upsert",
        "delete"
      ]
    },
    "version_mode": {
      "enum": [
        "source_version",
        "full_scan"
      ]
    },
    "source_version": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "source_updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "tenant_id",
    "source_ref",
    "scope_fingerprint",
    "product_id",
    "variant_id",
    "operation",
    "version_mode",
    "source_version",
    "source_updated_at",
    "observed_at",
    "payload"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "version_mode": {
            "const": "source_version"
          }
        }
      },
      "then": {
        "properties": {
          "source_version": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "version_mode": {
            "const": "full_scan"
          }
        }
      },
      "then": {
        "properties": {
          "source_version": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "delete"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "upsert"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object"
          }
        }
      }
    }
  ]
}
